##############################################
# 🌐 Banco de Dados – MongoDB (local, dev)
##############################################
MONGO_URI=mongodb://localhost:27017/gateway-db

##############################################
# 🚀 Servidor
##############################################
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
# URL pública do FRONT — usada em links de e-mail (ex.: convite de parceria)
FRONTEND_URL=

##############################################
# 🔐 Autenticação e Segurança JWT
##############################################
SECRET_TOKEN=troque-por-um-segredo-forte-e-aleatorio
ISSUER=gateway-api

##############################################
# ☁️ Armazenamento Seguro (Cloudinary)
##############################################
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

##############################################
# 💳 Integrações – ZENDRY
# Sem sandbox confirmado: toda chamada é contra produção (api.zendry.co,
# trocado de api.zendry.com.br em 2026-08-20 — painel novo da Zendry).
# Credenciais geradas no painel deles, seção "API Legada (compatível
# zendry.com)" — mesmas rotas/parâmetros/webhooks da API antiga.
# ZENDRY_WEBHOOK_SECRET agora vem do painel deles também (mecanismo antigo,
# ?key= na URL do webhook — mantido só por retrocompatibilidade).
# ZENDRY_HMAC_WEBHOOK_SECRET é o "Segredo de assinatura (HMAC SHA-256)" do
# painel novo (mesmo valor nos modos Nativo e Legado) — validado pelo
# código atual. Cadastre a URL deste webhook no campo "Webhook de
# recebimento (Pix recebido)" do painel deles pra confirmações chegarem.
##############################################
ZENDRY_CLIENT_ID=
ZENDRY_CLIENT_SECRET=
ZENDRY_WEBHOOK_SECRET=
ZENDRY_HMAC_WEBHOOK_SECRET=

##############################################
# 📧 E-mail transacional (Resend) — verificação de cadastro, esqueci senha,
# PIN de saque.
##############################################
RESEND_API_KEY=
EMAIL_FROM=

##############################################
# 📡 Segurança e Validação de Webhooks (recebidos de adquirentes)
##############################################
INTERNAL_WEBHOOK_SECRET=
WEBHOOK_ALLOWED_IPS=

##############################################
# 📊 Políticas de Segurança & Compliance
##############################################
MAX_TRANSACTION_AMOUNT=50000
MAX_DAILY_TRANSACTIONS=
MAX_FAILED_ATTEMPTS=
BLOCK_FOREIGN_IPS=

##############################################
# 🪪 Auditoria, PLD/FT e Flags de Risco
##############################################
ENABLE_TRANSACTION_AUDIT=
ENABLE_RISK_FLAGS=
